# Website and Betabotz Paygate
SITE_URL=https://donate.khasan.site
BTZ_BASE_URL=https://web.btzpay.my.id
BTZ_CALLBACK_URL=https://donate.khasan.site/api/paygate/callback
BTZ_RETURN_URL=https://donate.khasan.site/success
BTZ_QRISDANA_API_KEY=ISI_API_KEY_QRIS_DANA
BTZ_API_KEY=ISI_API_KEY_QRIS_ALTERNATIF_JIKA_NANTI_AKTIF
BTZ_QRISGOPAY_API_KEY=

# Existing JSONBin record: do not create a new bin if you need to retain history
JSONBIN_ID=ISI_ID_JSONBIN_LAMA
JSONBIN_KEY=ISI_MASTER_KEY_JSONBIN

# Admin and WhatsApp OTP via Wapito
ADMIN_PASSWORD=GANTI_DENGAN_PASSWORD_ADMIN_KUAT
WAPITO_API_KEY=ISI_TOKEN_WAPITO_BARU
WAPITO_API_URL=https://api.wapito.com/v1/messages/text
OTP_HASH_SECRET=ISI_SECRET_ACAK_PANJANG_DAN_STABIL

# Fees
DONATION_FEE_ENABLED=false
MEMBER_FEE_PERCENT=0.3
ANONYMOUS_FEE_PERCENT=0.7
EARLY_SUPPORTER_CUTOFF=

# Optional ShopeePay integration
BTZ_SHOPEEPAY_API_KEY=
BTZ_SHOPEEPAY_ACCOUNT_NUMBER=
BTZ_SHOPEEPAY_ACCOUNT_NAME=
